<?xml version="1.0" encoding="utf-8"?>
<!-- Transfert device-to-device (Android 12+) : rien n'est transféré.
     Le coffre libpho et les credentials restent sur l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
