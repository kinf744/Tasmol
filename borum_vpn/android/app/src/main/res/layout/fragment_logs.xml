<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/log_bg"
    android:orientation="vertical">

    <!-- En-tête élégant -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/logs_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/log_card_bg"
            android:contentDescription="Retour"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/log_text_dim" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal d'activité"
                android:textColor="@color/log_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/logs_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ce que fait l'application, étape par étape"
                android:textColor="@color/log_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/logs_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/log_card_bg"
            android:contentDescription="Partager le journal"
            android:src="@android:drawable/ic_menu_share"
            android:tint="@color/log_cyan" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/log_border" />

    <!-- Carte de protection des données sensibles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/log_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="🔒"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Ce journal contient uniquement les événements et les étapes de connexion. Aucune adresse de serveur, configuration ou donnée d'authentification sensible n'est affichée."
            android:textColor="@color/log_text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Filtres -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtrer les événements"
            android:textColor="@color/log_text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/logs_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/logs_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/log_border" />

    <!-- Actions : figer / vider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/logs_freeze_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/logs_freeze_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/log_orange" />

            <TextView
                android:id="@+id/logs_freeze_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Affichage figé"
                android:textColor="@color/log_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/logs_freeze"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/log_card_bg"
                android:text="Figer"
                android:textColor="@color/log_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/logs_clear"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@color/log_red"
            android:text="Vider le journal"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- État vide élégant -->
    <TextView
        android:id="@+id/logs_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="Aucun événement.\nConnectez-vous pour démarrer le journal."
        android:textColor="@color/log_text_dim"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Chronologie -->
    <ScrollView
        android:id="@+id/logs_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/logs_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp" />
    </ScrollView>
</LinearLayout>
