<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#0D1117">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GOAL FREE — Sonde Free Basics / Meta (MTN CM)"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#4CAF50"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hôtes candidats (1 par ligne — modifiables) :"
        android:textSize="12sp"
        android:textColor="#90A4AE" />

    <EditText
        android:id="@+id/hosts"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:gravity="top"
        android:typeface="monospace"
        android:textSize="11sp"
        android:textColor="#E0E0E0"
        android:background="#161B22"
        android:inputType="textMultiLine|textNoSuggestions" />

    <Spinner
        android:id="@+id/mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="#FFC107"
        android:textColor="#000000"
        android:textStyle="bold"
        android:text="LANCER LA SONDE" />

    <TextView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:typeface="monospace"
        android:textSize="12sp"
        android:textColor="#90A4AE"
        android:paddingTop="4dp"
        android:text="Prêt." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:backgroundTint="#90A4AE"
            android:textColor="#000000"
            android:text="Copier résultats" />

        <Button
            android:id="@+id/copyOk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#000000"
            android:text="Copier hôtes 200" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#101014">

        <TextView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="11sp"
            android:textColor="#D8F3D8"
            android:padding="6dp"
            android:text="Les résultats apparaîtront ici." />
    </ScrollView>
</LinearLayout>
