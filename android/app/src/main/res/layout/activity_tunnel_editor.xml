<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add server"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Name" />

        <EditText
            android:id="@+id/ed_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="My server" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Type" />

        <Spinner
            android:id="@+id/ed_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enabled" />

            <Switch
                android:id="@+id/ed_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Server"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lbl_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Host / IP" />

            <EditText
                android:id="@+id/ed_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="example.com" />

            <TextView
                android:id="@+id/lbl_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Port" />

            <EditText
                android:id="@+id/ed_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="443"
                android:inputType="number" />

            <TextView
                android:id="@+id/lbl_port_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Port range(s), comma-separated OK (ex: 6000-7750,7751-9500)"
                android:visibility="gone" />

            <EditText
                android:id="@+id/ed_port_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="6000-7750,7751-9500"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_ssh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SSH authentication"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Username" />

            <EditText
                android:id="@+id/ed_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Password" />

            <EditText
                android:id="@+id/ed_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

            <TextView
                android:id="@+id/lbl_ssh_proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Proxy ip:port (optional HTTP CONNECT hop)" />

            <EditText
                android:id="@+id/ed_ssh_proxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="127.0.0.1:8080" />

            <TextView
                android:id="@+id/lbl_ssh_payload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Payload (optional)" />

            <EditText
                android:id="@+id/ed_ssh_payload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="GET / HTTP/1.1[crlf]Host: [host][crlf][crlf]"
                android:minLines="2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_xray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Xray authentication"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="UUID" />

            <EditText
                android:id="@+id/ed_uuid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Flow" />

            <EditText
                android:id="@+id/ed_flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="xtls-rprx-vision" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Password (Trojan / Shadowsocks)" />

            <EditText
                android:id="@+id/ed_xpass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Method (Shadowsocks / VMess scy)" />

            <EditText
                android:id="@+id/ed_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="aes-256-gcm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_xray_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Import link or JSON"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ed_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="vless://... / vmess://... / trojan://... / ss://..."
                android:minLines="2" />

            <Button
                android:id="@+id/btn_parse_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Parse link" />

            <TextView
                android:id="@+id/lbl_outbound_json"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Outbound JSON (optional)" />

            <EditText
                android:id="@+id/ed_outbound_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint='{"protocol":"vless",...}'
                android:minLines="2"
                android:typeface="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_zivpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Zivpn UDP"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Password" />

            <EditText
                android:id="@+id/ed_zpass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

            <LinearLayout
                android:id="@+id/row_obfs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Obfs" />

                <Spinner
                    android:id="@+id/ed_obfs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_obfs_param"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Obfs param" />

                <EditText
                    android:id="@+id/ed_obfs_param"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="zivpn" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_slowdns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SlowDNS (dnstt)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Server public key (hex)" />

            <EditText
                android:id="@+id/ed_pubkey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nameserver domain" />

            <EditText
                android:id="@+id/ed_nsdomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ns.example.com" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DNS resolver (IP:port)" />

            <EditText
                android:id="@+id/ed_resolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="8.8.8.8:53" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sec_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Transport"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Network" />

            <Spinner
                android:id="@+id/ed_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Security" />

            <Spinner
                android:id="@+id/ed_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/sec_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Path / ServiceName" />

                <EditText
                    android:id="@+id/ed_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="/path" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Host" />

                <EditText
                    android:id="@+id/ed_wshost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sec_reality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="SNI" />

                <EditText
                    android:id="@+id/ed_sni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reality public key" />

                <EditText
                    android:id="@+id/ed_reality_pubkey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Short ID" />

                <EditText
                    android:id="@+id/ed_shortid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>