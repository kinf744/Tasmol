<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Rangée 1 : nom [+ coche sélection] ... modifier / cloner / supprimer.
         Le partage n'est PAS ici : il passe uniquement par le menu ⋮ de
         l'en-tête, qui exporte/importe la sélection. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- width=0dp + weight=1 : le nom se tronque en "…" (ellipsize) au
             lieu de s'étendre et de pousser les icônes hors de la carte. -->
        <TextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Profile"
            android:textColor="@color/npv_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <ImageButton
            android:id="@+id/item_edit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="Edit"
            android:padding="5dp"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/item_clone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Cloner le profil"
            android:padding="5dp"
            android:src="@drawable/ic_clone" />

        <ImageButton
            android:id="@+id/item_delete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete"
            android:padding="5dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- Rangée 2 : host:port ... protocole + ping (jaune, style NPV) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/npv_grey"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/item_rr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/npv_green"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/item_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/npv_grey"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/item_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Ping"
            android:textColor="#F2C94C"
            android:textSize="13sp"
            android:typeface="monospace" />
    </LinearLayout>
</LinearLayout>
