<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/npv_bg"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOTSPOT SHARE"
            android:textColor="@color/npv_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/hotspot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Arrêté"
            android:textColor="@color/npv_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ADRESSES LOCALES"
            android:textColor="@color/npv_grey"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/hotspot_ips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="@color/npv_text"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PORT RELAY"
            android:textColor="@color/npv_grey"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/hotspot_port"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="@color/npv_text"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CIBLE (défaut : SOCKS du VPN)"
            android:textColor="@color/npv_grey"
            android:textSize="12sp"
            android:typeface="monospace" />

        <EditText
            android:id="@+id/hotspot_target_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="127.0.0.1 (ou proxy d'une autre app VPN)"
            android:inputType="text"
            android:text="127.0.0.1"
            android:textColor="@color/npv_text"
            android:textColorHint="@color/npv_dim"
            android:typeface="monospace" />

        <EditText
            android:id="@+id/hotspot_target_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="port (ex: 10808)"
            android:inputType="number"
            android:textColor="@color/npv_text"
            android:textColorHint="@color/npv_dim"
            android:typeface="monospace" />

        <Button
            android:id="@+id/hotspot_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Démarrer le partage" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CÔTÉ CLIENT"
            android:textColor="@color/npv_grey"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/hotspot_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1. Connectez le VPN\n2. Démarrez le partage\n3. Sur l'autre appareil (même Wi-Fi) : proxy manuel SOCKS5 = IP ci-dessus, port ci-dessus, sans auth"
            android:textColor="@color/npv_grey"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TCP uniquement (l'association UDP reste locale). Sans root, le hotspot système ne passe pas par le VPN : utilisez ce proxy."
            android:textColor="@color/npv_dim"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
